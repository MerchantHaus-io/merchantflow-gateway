# Frontend (Vite) — safe to expose (anon key only). Copy to .env.local and fill in
# from your fresh Supabase project. No values are hardcoded in source.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Edge-function secrets (set with `supabase secrets set`, NOT in this file) ──
# LLM_API_KEY=            # shared, owner-hosted LLM provider key
# LLM_BASE_URL=           # e.g. https://ai.gateway.lovable.dev/v1  (OpenAI-compatible)
# STRIPE_SECRET_KEY=      # billing (Phase 1)
# STRIPE_WEBHOOK_SECRET=  # billing (Phase 1)
