{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cuqjaddtmkotgvfsgcol.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "the-ops-terminal",
      "version": "0.1.0",
      "title": "The Ops Terminal"
    },
    "tools": [
      {
        "name": "search_accounts",
        "title": "Search accounts",
        "description": "Search merchant accounts by name, with their location, website and commission model.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Partial account name to search for."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_opportunities",
        "title": "List opportunities",
        "description": "List CRM pipeline opportunities visible to the signed-in user, optionally filtered by stage or assignee.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "minLength": 1,
              "description": "Pipeline stage to filter by, e.g. 'discovery'."
            },
            "assigned_to": {
              "type": "string",
              "minLength": 1,
              "description": "Assignee name or email to filter by."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_opportunity",
        "title": "Get opportunity",
        "description": "Fetch one pipeline opportunity by id, including its account and primary contact details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "opportunity_id": {
              "type": "string",
              "format": "uuid",
              "description": "The opportunity's UUID."
            }
          },
          "required": [
            "opportunity_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_support_tickets",
        "title": "List support tickets",
        "description": "List support tickets with subject, requester, status and priority. Archived tickets are excluded unless requested.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "Ticket status to filter by, e.g. 'open' or 'closed'."
            },
            "include_archived": {
              "type": "boolean",
              "description": "Include archived tickets (default false)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List team tasks, optionally filtered by status or assignee email.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "Task status to filter by, e.g. 'open'."
            },
            "assignee": {
              "type": "string",
              "minLength": 1,
              "description": "Assignee email to filter by."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a task in the Ops Terminal, assigned to a team member by email.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short task title."
            },
            "description": {
              "type": "string",
              "maxLength": 2000,
              "description": "Optional task detail."
            },
            "assignee": {
              "type": "string",
              "format": "email",
              "description": "Assignee email address."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Task priority (default medium)."
            },
            "due_at": {
              "type": "string",
              "description": "Optional ISO 8601 due date/time."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
